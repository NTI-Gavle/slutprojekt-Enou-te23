# Ignore environment files (contains database credentials)
.env
.env.local
.env.*.local

# Composer dependencies (if used)
vendor/
composer.lock

# Node / frontend build files (optional)
node_modules/
dist/
build/

# PHP cache / temp files
*.log
*.cache
*.tmp
*.swp
*.DS_Store

# IDE / editor files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# OS generated files
Thumbs.db
Desktop.ini

# Uploaded files (user content - avatars, attachments)
uploads/
public/uploads/

# PHP error logs
php_errors.log
